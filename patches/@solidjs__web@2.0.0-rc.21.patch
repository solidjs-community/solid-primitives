diff --git a/dist/server.dev.js b/dist/server.dev.js
index 31fec1d89799cb577a016fb9af0779a9e6fcfdd4..a6beb0d8985af018b61e4d917c2718ffe4767919 100644
--- a/dist/server.dev.js
+++ b/dist/server.dev.js
@@ -367,8 +367,32 @@ function rewriteTree(value, visit, withPath) {
   } catch (err) {
     if (err !== CYCLE) throw err;
   }
-  return clone(value, visit, path, state.memo || (state.memo = new Map()));
+  const memo = state.memo || (state.memo = new Map());
+  return needsRewrite(value, visit, path, memo) ? clone(value, visit, path, memo) : value;
 }
+
+// Keep an untouched cyclic graph intact: cloning it breaks references shared
+// with other hydration records. Only changed graphs need the clone fallback.
+function needsRewrite(value, visit, path, memo, seen = new Set()) {
+  if (memo.has(value)) return memo.get(value) !== value;
+  if (seen.has(value)) return false;
+  seen.add(value);
+  const result = visit(value, path);
+  if (result !== DESCEND) {
+    memo.set(value, result);
+    return result !== value;
+  }
+  const type = shape(value);
+  if (type === 0) return false;
+  const keys = type === 1 ? null : Object.keys(value);
+  const length = keys ? keys.length : value.length;
+  for (let i = 0; i < length; i++) {
+    const child = value[keys ? keys[i] : i];
+    if (child !== null && typeof child === "object" && needsRewrite(child, visit, path, memo, seen)) return true;
+  }
+  return false;
+}
+
 function shape(value) {
   return Array.isArray(value) ? 1 : Object.getPrototypeOf(value) === Object.prototype ? 2 : 0;
 }
