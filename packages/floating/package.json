{
  "name": "@solid-primitives/floating",
  "version": "0.1.0",
  "description": "Floating element positioning — placement, offset, flip, shift, size and arrow, with auto-updating",
  "author": "David Di Biase <dave@solidjs.com>",
  "contributors": [],
  "license": "MIT",
  "homepage": "https://primitives.solidjs.community/package/floating",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs-community/solid-primitives.git"
  },
  "bugs": {
    "url": "https://github.com/solidjs-community/solid-primitives/issues"
  },
  "primitive": {
    "name": "floating",
    "stage": 0,
    "list": [
      "computePosition",
      "computePositionFromRects",
      "makeAutoUpdate",
      "createFloating",
      "getSizeCssVars",
      "applySizeCssVars"
    ],
    "category": "UI Patterns",
    "gzip": 3730
  },
  "keywords": [
    "solid",
    "primitives",
    "floating",
    "positioning",
    "popover",
    "tooltip",
    "dropdown",
    "anchor"
  ],
  "private": false,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {},
  "exports": {
    "import": {
      "@solid-primitives/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "typesVersions": {},
  "tsdown": {
    "entry": "src/**/*.{ts,tsx}",
    "outDir": "dist"
  },
  "scripts": {
    "dev": "node --import=@nothing-but/node-resolve-ts ../../scripts/dev.ts",
    "build": "pnpm -w build",
    "vitest": "vitest -c ../../configs/vitest.config.ts",
    "test": "pnpm run vitest",
    "test:ssr": "pnpm run vitest --mode ssr"
  },
  "dependencies": {
    "@solid-primitives/utils": "workspace:^"
  },
  "peerDependencies": {
    "@solidjs/web": "catalog:peer",
    "solid-js": "catalog:peer"
  },
  "devDependencies": {
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:peer"
  }
}
