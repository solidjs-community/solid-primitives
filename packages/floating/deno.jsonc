{
  "name": "@solid-primitives/floating",
  "version": "0.0.1",
  "description": "Floating element positioning — placement, offset, flip, shift, size and arrow, with auto-updating",
  "license": "MIT",
  "exports": "./src/index.ts",
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "src/**/*.ts",
      "src/**/*.tsx",
      "package.json"
    ],
    "exclude": [
      "dist",
      "dev",
      "test",
      "node_modules",
      "vitest.config.ts",
      "tsconfig.json"
    ]
  }
}
